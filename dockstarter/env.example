SNORKELWAFFLE_ABS_URL=http://audiobookshelf:80
SNORKELWAFFLE_LIBRARY_DIRS=/storage/media/podcasts
SNORKELWAFFLE_PORT_8484=8484
SNORKELWAFFLE_WEB_USERNAME=
SNORKELWAFFLE_WEB_PASSWORD=
